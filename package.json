{
  "name": "gpcpins-server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node --watch server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix app",
    "admin": "npm run dev --prefix admin",
    "agent": "npm run dev --prefix agent",
    "scanner": "npm run dev --prefix scanner",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "admin-dev": "concurrently \"npm run server\" \"npm run admin\"",
    "agent-dev": "concurrently \"npm run server\" \"npm run agent\"",
    "scan-dev": "concurrently \"npm run server\" \"npm run scanner\"",
    "whatsapp": "node session-manager/index.js",
    "main-server": "concurrently -n API,WA -c blue,green \"npm run server\" \"npm run whatsapp\"",
    "main-dev-server": "concurrently -n API,WA -c blue,green,yellow \"npm run server\" \"npm run whatsapp\" \"npm run client\""
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0 <=20.10.0"
  },
